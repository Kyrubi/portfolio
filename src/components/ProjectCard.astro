---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Card from './ui/Card.astro';
import Badge from './ui/Badge.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, year, tags, summary } = project.data;
const lang = getLangFromUrl(Astro.url);
---

<Card href={getRelativeLocaleUrl(lang, `/proyectos/${project.id}`)} data-scroll-reveal>
	<div class="mb-6 aspect-[4/3] w-full rounded-xl bg-gradient-to-br from-violet/40 via-pink/20 to-cyan/10"></div>
	<div class="flex items-center justify-between gap-4">
		<h3 class="text-2xl font-semibold tracking-tight">{title}</h3>
		<span class="font-mono text-xs text-ink-muted">{year}</span>
	</div>
	<p class="mt-2 text-sm text-ink-muted">{summary}</p>
	<div class="mt-4 flex flex-wrap gap-2">
		{tags.map((tag) => <Badge>{tag}</Badge>)}
	</div>
</Card>
