---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import ChromeCanvas from '../components/ChromeCanvas.astro';
import ChromeCanvasPBR from '../components/ChromeCanvasPBR.astro';
import AuraBackground from '../components/effects/AuraBackground.astro';
import { Icon } from 'astro-icon/components';
import ProjectGalleryMosaic from '../components/gallery/ProjectGalleryMosaic.astro';
import type { GalleryMediaItem } from '../components/gallery/types';

const galleryMockItems: GalleryMediaItem[] = [
	{
		id: 'desktop-home',
		title: 'Home desktop',
		gradientFallback: 'from-violet/50 via-pink/25 to-transparent',
		badge: 'Desktop',
		caption: 'Landing — versión escritorio'
	},
	{
		id: 'mobile-nav',
		title: 'Navegación móvil',
		gradientFallback: 'from-cyan/40 via-violet/30 to-transparent',
		badge: 'Mobile',
		caption: 'Menú y navegación'
	},
	{
		id: 'ui-detail',
		title: 'Detalle de componente',
		gradientFallback: 'from-pink/45 via-amber/20 to-transparent',
		badge: 'UI',
		caption: 'Micro-interacción de botón'
	},
	{
		id: 'editorial-poster',
		title: 'Pieza editorial',
		gradientFallback: 'from-amber/35 via-cyan/25 to-transparent',
		badge: 'Print',
		caption: 'Afiche vertical'
	},
	{
		id: 'dashboard-wide',
		title: 'Dashboard panorámico',
		gradientFallback: 'from-violet/40 via-cyan/30 to-pink/15',
		badge: 'Desktop',
		caption: 'Panel de métricas'
	},
	{
		id: 'asset-square',
		title: 'Asset cuadrado',
		gradientFallback: 'from-cyan/35 via-pink/20 to-transparent',
		badge: 'Asset',
		caption: 'Icono / mockup de marca'
	}
];
---

<Layout title="Design Preview — Chrome & Sparkle">
	<Section class="relative">
		<Badge>Página temporal — solo para revisión</Badge>
		<h1 class="mt-4 max-w-2xl text-3xl font-extrabold leading-tightest tracking-tightest sm:text-4xl">
			Comparación: plan original vs. implementación actual
		</h1>
		<p class="mt-4 max-w-2xl text-ink-muted">
			Esta ruta no está enlazada en la navegación y no tiene versión en inglés. Es solo para decidir si
			llevamos el chrome 3D y el efecto sparkle/lens-flare del plan original a producción, o si los
			descartamos. Bórrala (o pide que la borre) una vez que hayas decidido.
		</p>
	</Section>

	<Section class="pt-0">
		<h2 class="text-xl font-semibold tracking-tight">1. Material del icosaedro "chrome"</h2>
		<p class="mt-2 max-w-2xl text-sm text-ink-muted">
			Izquierda: el <code class="font-mono text-xs">ShaderMaterial</code> custom que está en producción hoy
			(Fresnel + ondas, sin reflejos reales). Derecha: <code class="font-mono text-xs">MeshPhysicalMaterial</code>
			con <code class="font-mono text-xs">envMap</code> generado por <code class="font-mono text-xs">RoomEnvironment</code>
			+ luces reales, tal como pedía el plan original (roughness 0.05, metalness 1, clearcoat 1, envMapIntensity 2.5).
		</p>

		<div class="mt-8 grid gap-6 md:grid-cols-2">
			<div>
				<div class="relative h-[380px] w-full overflow-hidden rounded-2xl border border-ink-muted/15 bg-void">
					<AuraBackground class="opacity-70" />
					<div class="absolute inset-0">
						<ChromeCanvas />
					</div>
				</div>
				<p class="mt-3 font-mono text-xs uppercase tracking-widest text-ink-muted">
					Actual — shader custom (producción)
				</p>
			</div>

			<div>
				<div class="relative h-[380px] w-full overflow-hidden rounded-2xl border border-ink-muted/15 bg-void">
					<AuraBackground class="opacity-70" />
					<div class="absolute inset-0">
						<ChromeCanvasPBR />
					</div>
				</div>
				<p class="mt-3 font-mono text-xs uppercase tracking-widest text-ink-muted">
					Propuesta — MeshPhysicalMaterial + envMap (plan original)
				</p>
			</div>
		</div>
	</Section>

	<Section class="pt-0">
		<h2 class="text-xl font-semibold tracking-tight">2. Sparkle / Lens Flare</h2>
		<p class="mt-2 max-w-2xl text-sm text-ink-muted">
			Del plan original: glow en iconos con <code class="font-mono text-xs">drop-shadow</code> +
			<code class="font-mono text-xs">mix-blend-mode: screen</code>, y un "prism glint" con gradiente de
			aberración cromática. Ninguno existe hoy en el sitio — esta es una primera pasada para evaluar si encaja.
		</p>

		<div class="relative mt-8 h-[280px] w-full overflow-hidden rounded-2xl border border-ink-muted/15 bg-void">
			<AuraBackground class="opacity-70" />
			<Icon
				name="lucide:sparkles"
				class="sparkle-glow absolute left-[12%] top-[22%] size-8 text-chrome"
				aria-hidden="true"
			/>
			<Icon
				name="lucide:sparkle"
				class="sparkle-glow absolute left-[68%] top-[55%] size-5 text-chrome [animation-delay:0.6s]"
				aria-hidden="true"
			/>
			<Icon
				name="lucide:star"
				class="sparkle-glow absolute left-[45%] top-[70%] size-4 text-chrome [animation-delay:1.1s]"
				aria-hidden="true"
			/>
			<Icon
				name="lucide:sparkle"
				class="sparkle-glow absolute left-[80%] top-[18%] size-6 text-chrome [animation-delay:1.6s]"
				aria-hidden="true"
			/>
			<div class="prism-glint pointer-events-none absolute inset-x-0 bottom-0 h-1"></div>
		</div>
		<p class="mt-3 font-mono text-xs uppercase tracking-widest text-ink-muted">
			Glow (drop-shadow + mix-blend screen) sobre AuraBackground, más una franja "prism glint" en el borde
			inferior
		</p>

		<div class="mt-10 grid gap-6 sm:grid-cols-2">
			<Card class="prism-hover relative overflow-hidden">
				<p class="font-mono text-xs uppercase tracking-widest text-ink-muted">Card sin prism glint</p>
				<p class="mt-2 text-ink">Borde estándar, como en producción hoy.</p>
			</Card>
			<Card class="prism-hover relative overflow-hidden">
				<div class="prism-glint pointer-events-none absolute inset-x-0 top-0 h-0.5"></div>
				<p class="font-mono text-xs uppercase tracking-widest text-ink-muted">Card con prism glint</p>
				<p class="mt-2 text-ink">Línea de aberración cromática como acento superior.</p>
			</Card>
		</div>
	</Section>

	<Section class="pt-0">
		<Badge>Propuesta 3/4 — página de proyecto</Badge>
		<h2 class="mt-4 text-xl font-semibold tracking-tight">3. Galería de imágenes/mockups</h2>
		<p class="mt-2 max-w-2xl text-sm text-ink-muted">
			Mosaico estático (sin carrusel ni auto-scroll): mismas cards de antes (hero panorámico, retrato móvil,
			cuadrado de detalle, con badge/caption/gradiente) pero acomodadas en un grid tipo mosaico con
			<code class="font-mono text-xs">gap-3</code>, sin movimiento continuo.
		</p>

		<div class="mt-8">
			<ProjectGalleryMosaic items={galleryMockItems} />
		</div>
		<p class="mt-3 font-mono text-xs uppercase tracking-widest text-ink-muted">
			Componente: ProjectGalleryMosaic — datos mock con gradientes de prueba (sin imágenes reales aún)
		</p>
	</Section>

	<Section class="pt-0">
		<Badge>Propuesta 4/4 — página de proyecto</Badge>
		<h2 class="mt-4 text-xl font-semibold tracking-tight">4. Métricas/resultados destacados</h2>
		<p class="mt-2 max-w-2xl text-sm text-ink-muted">
			Números o logros clave del proyecto mostrados como "stat cards", útiles cuando el proyecto tiene
			resultados medibles (engagement, tiempo de entrega, adopción, etc).
		</p>

		<div class="mt-8 grid gap-4 sm:grid-cols-3">
			<div class="rounded-2xl border border-ink-muted/15 bg-surface p-6">
				<p class="text-3xl font-extrabold tracking-tightest text-ink">+40%</p>
				<p class="mt-1 font-mono text-xs uppercase tracking-widest text-ink-muted">Engagement</p>
			</div>
			<div class="rounded-2xl border border-ink-muted/15 bg-surface p-6">
				<p class="text-3xl font-extrabold tracking-tightest text-ink">6</p>
				<p class="mt-1 font-mono text-xs uppercase tracking-widest text-ink-muted">Semanas de entrega</p>
			</div>
			<div class="rounded-2xl border border-ink-muted/15 bg-surface p-6">
				<p class="text-3xl font-extrabold tracking-tightest text-ink">12</p>
				<p class="mt-1 font-mono text-xs uppercase tracking-widest text-ink-muted">Piezas producidas</p>
			</div>
		</div>
	</Section>
</Layout>

<style>
	.sparkle-glow {
		filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.8));
		mix-blend-mode: screen;
		animation: sparkle-pulse 2.4s ease-in-out infinite;
	}

	.prism-glint {
		background: linear-gradient(90deg, #ff0055 0%, #00ffff 50%, #ffffff 100%);
	}

	@keyframes sparkle-pulse {
		0%,
		100% {
			opacity: 0.45;
			transform: scale(0.9);
		}
		50% {
			opacity: 1;
			transform: scale(1.05);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sparkle-glow {
			animation: none;
			opacity: 0.8;
		}
	}
</style>
