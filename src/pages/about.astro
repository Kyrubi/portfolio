---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import AuraBackground from '../components/effects/AuraBackground.astro';
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skillGroups = [
	{
		titleKey: 'about.skillsBackend',
		skills: [
			{ label: 'Java', icon: 'simple-icons:openjdk' },
			{ label: 'Spring Boot', icon: 'simple-icons:springboot' },
			{ label: '.NET', icon: 'simple-icons:dotnet' },
			{ label: 'NestJS', icon: 'simple-icons:nestjs' },
			{ label: 'Domain-Driven Design', icon: 'lucide:layers' },
			{ label: 'REST APIs', icon: 'lucide:route' }
		]
	},
	{
		titleKey: 'about.skillsFrontend',
		skills: [
			{ label: 'Angular', icon: 'simple-icons:angular' },
			{ label: 'Vue', icon: 'simple-icons:vuedotjs' },
			{ label: 'TypeScript', icon: 'simple-icons:typescript' },
			{ label: 'JavaScript', icon: 'simple-icons:javascript' }
		]
	},
	{
		titleKey: 'about.skillsDatabases',
		skills: [
			{ label: 'PostgreSQL', icon: 'simple-icons:postgresql' },
			{ label: 'MongoDB', icon: 'simple-icons:mongodb' }
		]
	},
	{
		titleKey: 'about.skillsMobile',
		skills: [
			{ label: 'Android', icon: 'simple-icons:android' },
			{ label: 'Flutter', icon: 'simple-icons:flutter' }
		]
	},
	{
		titleKey: 'about.skillsTools',
		skills: [
			{ label: 'Docker', icon: 'simple-icons:docker' },
			{ label: 'Git', icon: 'simple-icons:git' }
		]
	}
] as const;
---

<Layout title="About — Paul Sulca Gonzales">
	<div class="relative">
		<AuraBackground class="opacity-60" />
		<Section class="relative">
			<p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{t('about.eyebrow')}</p>
			<h1
				data-scroll-reveal
				class="mt-2 max-w-3xl text-4xl font-extrabold leading-tightest tracking-tightest sm:text-5xl"
			>
				{t('about.headline')}<span class="font-accent italic font-normal">{t('about.headlineAccent')}</span>{t('about.headlineEnd')}
			</h1>

			<div data-scroll-reveal class="mt-6 w-fit">
				<Badge>{t('about.juniorNote')}</Badge>
			</div>

			<p data-scroll-reveal class="mt-8 max-w-2xl text-lg text-ink-muted">
				{t('about.bio')}
			</p>

			<div data-scroll-reveal class="mt-6 flex flex-wrap gap-2">
				<Badge>{t('about.achievementLabel')}</Badge>
				<Badge>{t('about.courseLabel')}</Badge>
			</div>

			<div class="mt-20 grid gap-6 md:grid-cols-2">
				<div data-scroll-reveal>
					<p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{t('about.experienceTitle')}</p>
					<Card class="mt-4">
						<div class="flex items-baseline justify-between gap-4">
							<h3 class="text-xl font-semibold tracking-tight">{t('about.experienceRole')}</h3>
							<span class="font-mono text-xs text-ink-muted">{t('about.experiencePeriod')}</span>
						</div>
						<p class="mt-1 font-accent italic text-ink-muted">{t('about.experienceCompany')}</p>
						<p class="mt-4 text-sm text-ink-muted">{t('about.experienceDesc')}</p>
					</Card>
				</div>

				<div data-scroll-reveal>
					<p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{t('about.educationTitle')}</p>
					<Card class="mt-4">
						<div class="flex items-baseline justify-between gap-4">
							<h3 class="text-xl font-semibold tracking-tight">{t('about.educationSchool')}</h3>
						</div>
						<p class="mt-1 font-mono text-xs text-ink-muted">{t('about.educationPeriod')}</p>
					</Card>
				</div>
			</div>

			<div data-scroll-reveal class="mt-20">
				<p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{t('about.skillsTitle')}</p>
				<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{
						skillGroups.map((group) => (
							<div>
								<p class="font-mono text-[11px] uppercase tracking-widest text-ink-muted/70">
									{t(group.titleKey)}
								</p>
								<div class="mt-3 flex flex-wrap gap-2">
									{group.skills.map((skill) => (
										<Badge class="gap-1.5">
											<Icon name={skill.icon} class="size-3.5" aria-hidden="true" />
											{skill.label}
										</Badge>
									))}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</Section>
	</div>
</Layout>

<script>
	import { scrollReveal } from '../lib/animations';
	scrollReveal();
</script>
